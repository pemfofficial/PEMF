# Pirates_gog.exe / Pirates_cp.exe -- the game itself
re/bin/
# Ghidra database = disassembly of the copyrighted exe
re/ghidra_proj/
# wholesale decompilation dumps (derivative works). offsets.json is kept.
re/out/*.c
# game-exe backups + prior third-party mod data
backups/

