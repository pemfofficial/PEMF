// core.rc - version resource for pemf_core.dll.  See proxy.rc for rationale.

#include <winver.h>
#include "pemf_version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    PEMF_VER_N
 PRODUCTVERSION PEMF_VER_N
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      PEMF_COMPANY
            VALUE "FileDescription",  "PEMF core (narrative event engine)"
            VALUE "FileVersion",      PEMF_VER_S
            VALUE "InternalName",     "pemf_core"
            VALUE "LegalCopyright",   PEMF_COPYRIGHT
            VALUE "OriginalFilename", "pemf_core.dll"
            VALUE "ProductName",      PEMF_PRODUCT
            VALUE "ProductVersion",   PEMF_VER_S
            VALUE "Comments",         "Event engine for Sid Meier's Pirates! (2004). Reads PEMF\\events\\*.json."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
