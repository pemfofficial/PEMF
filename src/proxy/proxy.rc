// proxy.rc - version resource for the version.dll proxy.
//
// Without this the DLL ships with every identifying field blank and
// FileVersion 0.0.0.0, which is the worst possible profile for Windows
// reputation heuristics (SmartScreen, Smart App Control, AV).  It does not by
// itself satisfy a code-integrity policy -- only a signature does that -- but
// an anonymous binary is strictly worse than a named one.
//
// pemf_version.h is generated by build.ps1 so the version has one source.

#include <winver.h>
#include "pemf_version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    PEMF_VER_N
 PRODUCTVERSION PEMF_VER_N
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      PEMF_COMPANY
            VALUE "FileDescription",  "PEMF loader (version.dll proxy)"
            VALUE "FileVersion",      PEMF_VER_S
            VALUE "InternalName",     "pemf_proxy"
            VALUE "LegalCopyright",   PEMF_COPYRIGHT
            VALUE "OriginalFilename", "version.dll"
            VALUE "ProductName",      PEMF_PRODUCT
            VALUE "ProductVersion",   PEMF_VER_S
            VALUE "Comments",         "Forwards every export to the real Windows version.dll and loads pemf_core.dll. Modifies no game file."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
